        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "minimization": {
          "additionalProperties": true,
          "title": "Minimization",
          "type": "object"
        },
        "mutation_path": {
          "items": {
            "$ref": "#/$defs/MutationRecord"
          },
          "title": "Mutation Path",
          "type": "array"
        },
        "oracles": {
          "items": {
            "$ref": "#/$defs/OracleRecord"
          },
          "title": "Oracles",
          "type": "array"
        },
        "replay": {
          "$ref": "#/$defs/ReplayRecord"
        },
        "stability": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stability"
            },

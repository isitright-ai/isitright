        "pack": {
          "title": "Pack",
          "type": "string"
        },
        "search": {
          "$ref": "#/$defs/SearchRecord"
        },
        "stability": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stability"
            },
            {
              "type": "null"
            }
          ],
          "default": null

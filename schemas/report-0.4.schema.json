  "additionalProperties": false,
  "description": "The report of one audit: a single check, a suite, or an agent scenario.",
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/CaseReport"
      },
      "title": "Cases",
      "type": "array"
    },
    "elapsed_seconds": {
      "minimum": 0,
      "title": "Elapsed Seconds",
      "type": "number"
    },
    "kind": {
      "enum": [
        "case",
        "suite",
        "scenario"
      ],
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "pack": {
      "title": "Pack",
      "type": "string"
    },
    "schema_version": {
      "const": "0.4",
      "default": "0.4",
      "title": "Schema Version",
      "type": "string"
    },
    "totals": {
      "$ref": "#/$defs/Totals"
    }
  },
  "required": [
    "pack",
    "kind",
    "cases",
    "totals",
    "elapsed_seconds"

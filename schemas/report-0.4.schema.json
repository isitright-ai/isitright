    "Finding": {
      "additionalProperties": false,
      "description": "One disagreement in one world; attribution is separate and undetermined by default.",
      "properties": {
        "divergence": {
          "additionalProperties": true,
          "title": "Divergence",
          "type": "object"
        },
        "export": {
          "anyOf": [

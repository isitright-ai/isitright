        "execution_fidelity": {
          "$ref": "#/$defs/FidelityRecord"
        },
        "extensions": {
          "additionalProperties": true,
          "title": "Extensions",
          "type": "object"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "oracles": {
          "items": {
            "$ref": "#/$defs/OracleRecord"
          },
          "title": "Oracles",
          "type": "array"
        },
        "original_state": {
          "additionalProperties": true,
          "title": "Original State",
          "type": "object"

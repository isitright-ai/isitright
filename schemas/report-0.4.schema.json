      "enum": [
        "UNDETERMINED",
        "AGENT_DEFECT",
        "REFERENCE_DEFECT",
        "AMBIGUOUS_TASK",
        "POLICY_AMBIGUOUS",
        "TOOL_CONTRACT_AMBIGUOUS",
        "SIMULATOR_DEFECT"
      ],
      "title": "AttributionStatus",
      "type": "string"
    },

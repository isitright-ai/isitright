      "type": "object"
    },
    "Counts": {
      "additionalProperties": false,
      "description": "What happened in n runs of one world. Counts only.",
      "properties": {
        "cannot_judge": {
          "minimum": 0,
          "title": "Cannot Judge",
          "type": "integer"
        },
        "errors": {
          "minimum": 0,
          "title": "Errors",
          "type": "integer"
        },
        "met": {
          "minimum": 0,
          "title": "Met",
          "type": "integer"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "not_met": {
          "minimum": 0,
          "title": "Not Met",
          "type": "integer"
        },
        "violated": {
          "minimum": 0,
          "title": "Violated",
          "type": "integer"
        }
      },
      "required": [
        "n",
        "met",
        "not_met",
        "cannot_judge",
        "violated",
        "errors"
      ],
      "title": "Counts",
      "type": "object"
